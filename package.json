{
  "name": "music-mcp-server",
  "version": "1.0.0",
  "description": "A music search and playback service powered by Netease Cloud Music API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:netease": "PORT=4000 npx NeteaseCloudMusicApi",
    "start:all": "concurrently \"npm run start:netease\" \"npm run dev\""
  },
  "keywords": [
    "netease",
    "music",
    "search",
    "api",
    "cloud-music"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "NeteaseCloudMusicApi": "^4.15.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  }
}

